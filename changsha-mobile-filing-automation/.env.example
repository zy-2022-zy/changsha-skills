# 目标系统入口。通常无需修改。
MOBILE_PORTAL_BASE_URL=https://wap.hn.10086.cn/ismsports/

# 保存登录会话的目录。不要提交该目录，它可能含会话 Cookie。
PLAYWRIGHT_PROFILE_DIR=.automation-profile

# 结果下载目录。可使用绝对路径。
DOWNLOAD_DIR=downloads

# 业务目录。程序会自动创建以下子目录：待报备、已经报备、报备结果资料。
# 设置为 D:\\报备 后，可直接把待处理文件放进 D:\\报备\\待报备。
FILING_ROOT_DIR=D:\\报备
PENDING_DIR=D:\\报备\\待报备
COMPLETED_DIR=D:\\报备\\已经报备
REPORT_RESULT_DIR=D:\\报备\\报备结果资料

# 单文件任务状态目录，可用于中断后恢复，里面不保存账号或验证码。
STATE_DIR=reports

# 轮询导入结果的配置。
RESULT_POLL_INTERVAL_MS=15000
RESULT_POLL_TIMEOUT_MS=300000

# 默认使用已安装的 Google Chrome；也可改为 msedge 使用 Microsoft Edge。
BROWSER_CHANNEL=chrome

# 可选：登录页自动填入的手机号。只保存在本机 .env，不写入运行日志或远端日志。
# LOGIN_PHONE=13800138000

# 本地智能体服务配置（运行 `pnpm start -- serve` 时使用）。
SERVICE_HOST=127.0.0.1
SERVICE_PORT=8787
# 建议客户环境设置随机令牌；设置后 API 必须带 Authorization: Bearer <令牌>。
# SERVICE_TOKEN=

# 可选：把执行结果日志发送到远端日志服务器。
# 日志只包含任务状态、文件名、批次号、数量和错误摘要，不包含密码、验证码或 Cookie。
# REMOTE_LOG_URL=https://log.example.com/api/v1/events
# REMOTE_LOG_TOKEN=
REMOTE_LOG_TIMEOUT_MS=10000

# 可选：将每次中文运行结果推送到企业微信机器人。
# WECHAT_WORK_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=替换为机器人Key
